{
  "name": "auditit-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Graph-based financial audit and causal analysis platform",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"blue.bold,cyan.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && uv run uvicorn src.api.main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:docs": "cd docs && npm run dev",
    "test:backend": "cd backend && uv run pytest",
    "build:frontend": "cd frontend && npm run build",
    "build:docs": "cd docs && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
